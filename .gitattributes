* text=auto
*.py text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.pdf binary
*.png binary
*.jpg binary
# Source snapshots and manifests contain byte-level hashes; preserve their bytes.
materials/** -text whitespace=-blank-at-eol,-blank-at-eof
materials/**/raw/** -diff
materials/raw/** -diff
